{
  "name": "even-realities",
  "version": "0.0.0",
  "private": true,
  "description": "Even Realities G2 apps and the packages they share.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace dash",
    "codegen": "npm run codegen --workspace @andrewheschl/dash-api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
