{
  "name": "@andrewheschl/dash-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client and generated OpenAPI types for the Dash backend.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "codegen": "openapi-typescript https://dash.andrewheschl.ca/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
